# Copy to backend/.env for local settings. Never commit .env.
# If the provider's key is set here (or as an environment variable), main.py uses it;
# otherwise it asks for the key at startup with hidden input.
LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# SQLite file for chat sessions; defaults to backend/manager_copilot.db
# SQLITE_PATH=
